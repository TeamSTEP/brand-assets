{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!src/**/*.stories.tsx"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "check-api": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "etc/**"]
    },
    "check-contrast": {
      "inputs": ["$TURBO_DEFAULT$", "tokens/**", "src/**/*.css", "scripts/check-token-contrast.mjs"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "rules/**"]
    },
    "verify-governance": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "inputs": ["$TURBO_DEFAULT$", ".storybook/**"],
      "outputs": ["storybook-static/**"]
    },
    "test-visual": {
      "dependsOn": ["build-storybook"],
      "env": ["CI"],
      "inputs": ["$TURBO_DEFAULT$", "tests/**", "playwright.config.ts"],
      "outputs": ["playwright-report/**"]
    }
  }
}
